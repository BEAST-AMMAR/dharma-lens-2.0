# NyayaSetu (न्याय-सेतु) - Environment Configuration Template
# All services configured with security best practices

# SUPABASE CONFIGURATION
VITE_SUPABASE_URL="https://harbkllyyyatxqwolsea.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_PROJECT_ID="harbkllyyyatxqwolsea"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# API & LLM CONFIGURATION
OPENROUTER_API_KEY="your-openrouter-api-key"
OLLAMA_BASE_URL="http://host.docker.internal:11434"
VITE_API_GATEWAY_URL="http://localhost:3000"

# DATABASE CONFIGURATION
DB_PASSWORD="your-db-password"
DB_USER="admin"
DB_NAME="nyayasetu"
DB_HOST="database"
DB_PORT="5432"
DATABASE_URL="postgresql://admin:your-db-password@database:5432/nyayasetu"

# REDIS CONFIGURATION
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_URL="redis://redis:6379"

# GRAFANA CONFIGURATION
GRAFANA_PASSWORD="your-grafana-password"
GRAFANA_USER="admin"
GF_SECURITY_ADMIN_PASSWORD="your-grafana-password"

# NODE & PYTHON ENVIRONMENT
NODE_ENV="production"
PYTHON_ENGINE_URL="http://python_engine:8000/process"
PYTHONUNBUFFERED="1"

# MONITORING & LOGGING
PROMETHEUS_RETENTION="15d"
LOG_LEVEL="INFO"
